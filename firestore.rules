rules_version = '2';
// Firestore のセキュリティルール（Firebaseコンソール → Firestore Database → ルール に全文を貼り付けて「公開」）
// ・本人のセーブ（saves/自分のuid）だけ読み書きできる。他人のデータは1件も見えない・書けない
// ・決められた項目・大きさ以外は書き込めない（大量データの押し付けや別用途への悪用を防ぐ）
// ・それ以外の場所はすべて禁止
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    function validSave() {
      let d = request.resource.data;
      return d.keys().hasOnly(['save', 'updatedAt', 'gameVersion', 'summary', 'serverTime', 'fcmToken', 'fcmUpdated'])
        && (!('save' in d) || (d.save is string && d.save.size() < 600000))
        && (!('updatedAt' in d) || d.updatedAt is number)
        && (!('gameVersion' in d) || (d.gameVersion is string && d.gameVersion.size() <= 20))
        && (!('summary' in d) || (d.summary is map && d.summary.size() <= 12))
        && (!('serverTime' in d) || d.serverTime is timestamp)
        && (!('fcmToken' in d) || (d.fcmToken is string && d.fcmToken.size() < 4096))
        && (!('fcmUpdated' in d) || d.fcmUpdated is timestamp);
    }

    match /saves/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid) && validSave();
      allow delete: if isOwner(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
